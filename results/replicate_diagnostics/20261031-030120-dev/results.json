  "definitions": {
    "J": "hindsight label: mean over the R replicates of the branch total cost under the true cause (dataset.candidate_labels)",
    "J_belief": "P(c | E) J(a | c) + P(c' | E) J(a | c', h) for mixed decisions (dataset.belief_labels); J elsewhere",
    "TOL": "1e-09: exact equality of costs (dataset_stats.TOL)",
    "abs_J_belief_minus_J_per_candidate": "|J_belief - J| pooled over every candidate of the group's decisions (mean and median per candidate, not per decision)",
    "argmin_set": "candidates with J <= min J + TOL (ties included)",
    "bootstrap": "per decision, n_boot draws of R replicate ids with replacement, one draw shared by all candidates and both worlds; J and J_belief recomputed from the drawn replicates (posterior fixed); p_disjoint = mean share of draws whose argmin set shares no candidate with the original one; p_set_differs = mean share whose argmin set is not identical; p_flip = mean share whose gathering-optimal answer differs from the original (decisions with both families). Means over the decisions of the subset; *_mc_se = Monte Carlo SE of that mean from the finite number of draws, sqrt(sum p (1 - p) / (n_boot - 1)) / n. *_gather_optimal subsets: decisions whose original answer (under that label set) is gathering optimal",
    "citation_changed": "the twin branches' first-action citation differs from the primary's (list of evidence ids): primary ids not citable in the twin were dropped, or replaced by shared world evidence when none was left",
    "citation_replaced": "the twin's first-action citation holds none of the primary's cited ids",
    "decision_subsets": {
      "all": "every labelled development decision",
      "ambiguous_family": "decisions of episodes whose incident is a link fault on sensor:<g> or an I/O-module fault on <g> (dataset.in_family = arrays dec_family; the paper's 'ambiguous decisions', 42.3% / 58.2% of development decisions)",
      "family_with_twin_record": "ambiguous_family decisions with a twin record and a defined pi_after_memory_differs (the denominator of dataset_stats.twin_stats)",
      "high_stakes": "the hindsight trip probability differs across candidates: max p_trip > min p_trip + TOL (dataset_stats stakes; the paper's high-stakes decisions)",
      "twin_weight_pos": "ambiguous_family decisions whose twin was labelled and has posterior P(c' | E) > 0 (deterministic evidence did not exclude the twin); the verifier's 'ambiguous' and the investigator's 'ambiguous (twin weight > 0)' in the triage reports"
    },
    "development_pool": "train and val episodes of the set (split_of(seed, (0.6, 0.2, 0.2)) from the file name, before unpickling); the test split is never read",
    "exact_tie": "the argmin set has more than one candidate",
    "flagged_share": "share of twin_weight_pos decisions with pi_after_memory_differs True",
    "gathering_optimal": "decision with both observe and non-observe candidates whose best observe J is below the best non-observe J by more than TOL (dataset_stats); undefined without both",
    "p_trip_strictly_between": "share of candidates (every decision, primary world) whose trip probability over the R replicates is strictly between 0 and 1",
    "pi_after_memory_differs": "stored per decision in the twin record: the twin world's own playbook (history h') remembers other trace results or actuator link-loss reports at tau than the defender's playbook (history h) that the twin labels use",
    "remembered_trace": "the latest-arriving (ties: largest evidence id) trace_link item on sensor:<g> among the decision's valid_evidence; its world health and reported health come from the twin's belief record (matched by event time)",
    "remembered_trace_wrong": "the remembered trace's reported health differs from the true world's health",
    "replicate_sd": "per candidate, the SD (ddof = 1) of the branch total over its R replicates; primary: every candidate of every decision; twin: every candidate of every decision with a labelled twin (twin weight 0 included)",
    "runner_up_unresolved_t95": "decisions with a runner-up (a candidate above min J + TOL): gap to the first runner-up <= t_{0.975, R-1} times the SE of the paired replicate difference (dataset_stats.best_stats unresolved_t95_share); _2se with 2 instead of t",
    "split_halves": "the first R/2 replicates against the last R/2 (R = 4: replicate ids {0, 1} against {2, 3}), in both worlds: argmin sets overlap (share a candidate), and the gathering-optimal answer agrees (decisions with both families)",
    "tie_identical": "every pair of tied candidates has costs within TOL in every replicate (for belief ties: in both worlds where the twin enters J_belief)",
    "tie_monitor_only": "every tied candidate is a monitor action",
    "trace_rule": "a remembered trace exists and the two worlds' link health differed when it was taken",
    "twin_weight": "P(c' | E), the posterior of the twin cause (belief.posterior of the twin's belief record)"
  },
  "notes": {
    "bootstrap": "A bootstrap over R = 4 values understates the replicate variance (a resampled mean has (R - 1) / R of it), so these probabilities probably understate the label instability; they are not proven bounds.",
    "citation": "The triage reports' 'twin's first action cites substitute evidence' (11.6% / 9.1%) is citation_changed, in most of which primary ids were only dropped; substitution proper (none of the primary's ids left) is citation_replaced.",
    "ties": "Ties at the minimum are ties of identical trajectories under common random numbers, not ties of noisy means: in all but a handful of tie decisions (tied_identical_every_replicate) the tied candidates, mostly the two monitor durations (300 s and 900 s), have identical costs in every stored replicate. Whether they stay identical in further replicates depends on whether pi_after acts during the longer wait, a stochastic event.",
    "triage_subset_names": "The triage reports' C5 'family' = ambiguous_family; the verifier's 'ambiguous' and its corrected LaTeX ('13.7% / 14.0% of resamples of ambiguous decisions', 'flips ... in 6.7%') = twin_weight_pos; 'gather flips among belief-gather-optimal decisions, n = 205 / 640' = ambiguous_family_gather_optimal, n = 218 / 654 = all_gather_optimal."
  },
